generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  displayName   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  accountLinks  AccountLink[]
  watchProgress WatchProgress[]
  readProgress  ReadProgress[]
  syncCursors   SyncCursor[]
}

model AccountLink {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerUserId  String?
  accessTokenEnc  String
  linkedAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model WatchProgress {
  id             String   @id @default(cuid())
  userId         String
  mediaKind      String
  canonicalKey   String
  title          String
  posterUrl      String?
  episodeNumber  Int      @default(1)
  episodeLabel   String?
  positionSec    Float    @default(0)
  durationSec    Float?
  percent        Float    @default(0)
  routeJson      Json?
  anilistId      Int?
  completed      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalKey])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, mediaKind, updatedAt(sort: Desc)])
}

model ReadProgress {
  id             String   @id @default(cuid())
  userId         String
  mediaKind      String
  canonicalKey   String
  title          String
  posterUrl      String?
  provider       String
  mediaId        String
  chapterId      String?
  chapterNumber  Float?
  pageIndex      Int      @default(0)
  totalPages     Int?
  percent        Float    @default(0)
  language       String?
  routeJson      Json?
  anilistId      Int?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalKey])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, mediaKind, updatedAt(sort: Desc)])
}

model SyncCursor {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  cursorKey String
  cursorVal String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, cursorKey])
  @@index([userId, provider])
}
